# Sao thành /etc/fittrack-api/api.env  rồi:  sudo chown <user-chạy-pm2> api.env && sudo chmod 600 api.env
# Mỗi dòng KEY=VALUE. Dấu "__" tương ứng ":" trong appsettings.json.

# Chuỗi kết nối SQL Server (đổi mật khẩu đúng với login fittrack_api đã tạo ở 02_CreateApiLogin.sql).
# - TrustServerCertificate=True: cần khi SQL Server dùng chứng chỉ tự ký (mặc định trên Linux/Docker).
#   Nếu DB ở máy khác qua mạng thật, nên cài chứng chỉ hợp lệ rồi bỏ tham số này.
# - Mật khẩu chứa ; hoặc " thì bọc trong nháy đơn:  Password='abc;123'
ConnectionStrings__Default=Server=localhost,1433;Database=FitTrackCloud;User Id=fittrack_api;Password=THAY_MAT_KHAU;TrustServerCertificate=True;Encrypt=True

# project_id trong app/google-services.json của app Android
Firebase__ProjectId=fittrack-bf1cd

# Số snapshot giữ lại cho mỗi người dùng
CloudSave__MaxBackupsPerUser=5
