<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FitTrack.Api</RootNamespace>
    <AssemblyName>FitTrack.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- "10.0.*" = luôn lấy bản vá mới nhất của dòng 10.0 khi restore. Muốn cố định thì thay bằng số cụ thể. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
  </ItemGroup>

</Project>
